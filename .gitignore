# Build output lives at the repository root.  Anchor this pattern so a Java
# package such as `com/mojang/brigadier/builder/` remains visible to Git/tools.
/build*/
build-asan/
*.o
server.properties
# Keep runtime world directories ignored at the repository root.  An
# unanchored `world/` pattern also hides Java package trees such as
# `jvm/java/net/minecraft/world/**`.
/world/
/world_nether/
/world_the_end/
__pycache__/
captures/
plan/
CONTINUATION_STATE.md
NEXT_STEPS.md
*.pdf
Testing/
.VSCodeCounter/
.vscode/
.idea/
**/.audit-cache/
banned-*.json
ops.json
ops.json
