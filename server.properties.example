# Supported cppfm server.properties settings. Unsupported vanilla keys are
# intentionally omitted instead of being shown as if they changed behavior.
server-port=25565
max-players=20
view-distance=10
simulation-distance=10
level-type=minecraft:normal
difficulty=easy
motd=A Minecraft Server
level-seed=
spawn-protection=16
online-mode=true
white-list=false
pvp=true
allow-flight=false
hardcore=false
enforce-secure-profile=true
network-compression-threshold=256
enable-rcon=false
rcon.port=25575
rcon.password=
resource-pack=
resource-pack-sha1=
require-resource-pack=false
# Java integration is enabled by default when a compatible JDK is available.
# Set jvm=false for a native-only run, or jvm-strict=true to fail startup when
# the JDK/embedded compatibility classes cannot be loaded.
jvm=true
jvm-strict=false
# jvm-mods=mods
# jvm-config=config

# Maximum loaded chunks (0=unlimited). Default is max(8192, view-distance²*4).
#max-loaded-chunks=8192
#io-worker-threads=4

# Optional path/JVM settings: values may contain spaces.
#world-dir=world
#jvm-classes=
#jvm-mods=mods
#jvm-config=config
#jvm-java-home=
#jvm-library=
#jvm-libraries=
