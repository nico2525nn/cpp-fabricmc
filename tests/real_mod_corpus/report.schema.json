{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpp-fabricmc.local/schema/real-mod-corpus-report-v1.json",
  "title": "cpp-fabricmc plan51 real Fabric mod corpus report",
  "type": "object",
  "required": [
    "schema",
    "suite",
    "status",
    "statusReason",
    "game",
    "lock",
    "execution",
    "summary",
    "artifacts",
    "combined",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "cppfm.real-mod-corpus.report.v1"
    },
    "suite": {
      "const": "cppfm-plan51-real-mod-corpus"
    },
    "status": {
      "enum": ["PASS", "FAIL", "SKIP"]
    },
    "statusReason": {
      "type": "string",
      "minLength": 1
    },
    "game": {
      "type": "object",
      "required": ["id", "version", "protocol"],
      "properties": {
        "id": {"const": "minecraft"},
        "version": {"const": "1.21.4"},
        "protocol": {"const": 769}
      }
    },
    "lock": {
      "type": "object",
      "required": ["path", "sha256", "modCount"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "modCount": {"const": 3}
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "networkAccessed",
        "executionAttempted",
        "reference",
        "cppfm",
        "cache",
        "fabricRuntime",
        "java"
      ],
      "properties": {
        "networkAccessed": {"const": false},
        "executionAttempted": {"type": "boolean"},
        "reference": {"type": "object"},
        "cppfm": {"type": "object"},
        "cache": {"type": "object"},
        "fabricRuntime": {"type": "object"},
        "java": {"type": "object"}
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "skipped"],
      "properties": {
        "total": {"const": 3},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/case"}
    },
    "combined": {
      "$ref": "#/$defs/case"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "SKIP"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "side": {
      "type": "object",
      "required": ["status", "phases", "process"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "SKIP"]},
        "phases": {
          "type": "object",
          "required": ["load", "initialize", "behavior", "shutdown"],
          "properties": {
            "load": {"$ref": "#/$defs/phase"},
            "initialize": {"$ref": "#/$defs/phase"},
            "behavior": {"$ref": "#/$defs/phase"},
            "shutdown": {"$ref": "#/$defs/phase"}
          }
        },
        "process": {"type": "object"}
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "status", "metadata", "reference", "cppfm"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "SKIP"]},
        "metadata": {"type": "object"},
        "reference": {"$ref": "#/$defs/side"},
        "cppfm": {"$ref": "#/$defs/side"}
      }
    }
  }
}
